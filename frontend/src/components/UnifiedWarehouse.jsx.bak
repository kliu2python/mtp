import React, { useState, useEffect } from 'react';
import {
  Button,
  Card,
  Input,
  Modal,
  Select,
  Space,
  Upload,
  message,
  Form,
  Row,
  Col,
  List,
  Typography
} from 'antd';
import {
  CopyOutlined,
  UploadOutlined,
  UserOutlined,
  LockOutlined,
  ReloadOutlined
} from '@ant-design/icons';
import axios from 'axios';
import { API_URL } from '../constants';

const { Option } = Select;
const { Text, Title } = Typography;

// Authentication Functions
const generateOTP = async (email, setLoading) => {
  setLoading(true);
  try {
    const response = await axios.post(`${API_URL}/api/warehouse/generate-otp`, { email });
    message.success(response.data.message);
    return true;
  } catch (error) {
    console.error('OTP Generation error:', error);

    // Even if email sending fails, the OTP might still be in the database
    // Show a message that they should check their email or contact admin
    if (error.response?.status === 500) {
      message.warning('OTP may have been generated but email sending failed. Please contact administrator or try again.');
      return true; // Still proceed to verification step
    } else {
      message.error('Failed to generate OTP: ' + (error.response?.data?.detail || error.message));
      return false;
    }
  } finally {
    setLoading(false);
  }
};

const verifyOTP = async (email, otpCode, setLoading, setIsAuthenticated, setUserEmail) => {
  if (!email || !otpCode) {
    message.warning('Please enter both email and OTP code');
    return false;
  }

  setLoading(true);
  try {
    const response = await axios.post(`${API_URL}/api/warehouse/verify-otp`, { email, otp_code: otpCode });
    if (response.data.success) {
      message.success(response.data.message);
      setIsAuthenticated(true);
      setUserEmail(email);
      localStorage.setItem('warehouseUserEmail', email);
      return true;
    }
  } catch (error) {
    console.error('OTP Verification error:', error);
    message.error('Failed to verify OTP: ' + (error.response?.data?.detail || error.message));
    return false;
  } finally {
    setLoading(false);
  }
};

const checkAuthenticationStatus = async (email, setIsAuthenticated) => {
  if (!email) return;

  try {
    const response = await axios.get(`${API_URL}/api/warehouse/is-authenticated/${email}`);
    setIsAuthenticated(response.data.is_authenticated);
  } catch (error) {
    console.error('Authentication check error:', error);
    setIsAuthenticated(false);
  }
};

// Unified Warehouse Functions
const fetchWarehouseCounts = async (setCounts) => {
  try {
    const response = await axios.get(`${API_URL}/api/warehouse/count`);
    setCounts(response.data);
  } catch (error) {
    // Silent fail, will show 0 counts
  }
};

const fetchWarehouseActivities = async (setActivities) => {
  try {
    const response = await axios.get(`${API_URL}/api/warehouse/activities`);
    setActivities(response.data);
  } catch (error) {
    // Silent fail
  }
};

const handleCopyRandomCode = async (selectedType, setLoading, setCounts, userEmail) => {
  setLoading(true);
  try {
    const response = await axios.post(`${API_URL}/api/warehouse/random`, null, {
      params: { code_type: selectedType === 'All' ? null : selectedType },
      headers: {
        'Authorization': `Bearer ${userEmail}`
      }
    });

    if (response.data.code) {
      let successMessage = `${response.data.code_type} code copied to clipboard`;
      if (response.data.size) {
        successMessage += ` (Size: ${response.data.size})`;
      }
      await navigator.clipboard.writeText(response.data.code);
      message.success(successMessage);
      fetchWarehouseCounts(setCounts);
    } else {
      message.warning('No available codes');
    }
  } catch (error) {
    message.error('Failed to retrieve code: ' + (error.response?.data?.detail || 'Authentication required'));
  } finally {
    setLoading(false);
  }
};

const handleRecycleCode = async (recycleCode, setRecycleCode, setLoading, setCounts, userEmail) => {
  if (!recycleCode.trim()) {
    message.warning('Please enter a code to recycle');
    return;
  }

  setLoading(true);
  try {
    await axios.post(`${API_URL}/api/warehouse/recycle`, { code: recycleCode.trim() }, {
      headers: {
        'Authorization': `Bearer ${userEmail}`
      }
    });
    message.success('Code recycled successfully');
    setRecycleCode('');
    fetchWarehouseCounts(setCounts);
  } catch (error) {
    console.error('Recycle error:', error);
    message.error('Failed to recycle code: ' + (error.response?.data?.detail || 'Authentication required'));
  } finally {
    setLoading(false);
  }
};

const handleUploadCodes = async (fileList, setUploadModalVisible, setFileList, setLoading, setCounts, userEmail) => {
  if (fileList.length === 0) {
    message.warning('Please select at least one PDF file');
    return;
  }

  const formData = new FormData();
  fileList.forEach(file => {
    // Use the actual file object
    if (file.originFileObj) {
      formData.append('files', file.originFileObj);
    } else {
      formData.append('files', file);
    }
  });

  setLoading(true);
  try {
    const response = await axios.post(`${API_URL}/api/warehouse/upload`, formData, {
      headers: {
        'Content-Type': 'multipart/form-data',
        'Authorization': `Bearer ${userEmail}`
      },
    });
    message.success(`Successfully uploaded ${fileList.length} files`);
    setUploadModalVisible(false);
    setFileList([]);
    // Refresh count after upload
    fetchWarehouseCounts(setCounts);
  } catch (error) {
    console.error('Upload error:', error);
    message.error('Failed to upload files: ' + (error.response?.data?.detail || 'Authentication required'));
  } finally {
    setLoading(false);
  }
};

const UnifiedWarehouse = () => {
  const [loading, setLoading] = useState(false);
  const [uploadModalVisible, setUploadModalVisible] = useState(false);
  const [fileList, setFileList] = useState([]);

  // Authentication states
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [userEmail, setUserEmail] = useState('');
  const [otpEmail, setOtpEmail] = useState('');
  const [otpCode, setOtpCode] = useState('');
  const [otpLoading, setOtpLoading] = useState(false);
  const [showOtpModal, setShowOtpModal] = useState(false);
  const [authForm] = Form.useForm();

  // Warehouse states
  const [counts, setCounts] = useState({
    fortigate: 0,
    fortiauthenticator: 0,
    fortitoken: 0,
    fortidentitycloud: 0,
    total: 0
  });

  const [activities, setActivities] = useState([]);
  const [selectedType, setSelectedType] = useState('All');
  const [recycleCode, setRecycleCode] = useState('');

  // Load counts and check authentication on component mount
  useEffect(() => {
    fetchWarehouseCounts(setCounts);
    fetchWarehouseActivities(setActivities);

    // Check for saved user email
    const savedEmail = localStorage.getItem('warehouseUserEmail');
    if (savedEmail) {
      setUserEmail(savedEmail);
      setOtpEmail(savedEmail);
      checkAuthenticationStatus(savedEmail, setIsAuthenticated);
    }
  }, []);

  const uploadProps = {
    multiple: true,
    fileList: fileList,
    accept: '.pdf',
    beforeUpload: (file) => {
      // Only allow PDF files
      if (file.type !== 'application/pdf' && !file.name?.endsWith('.pdf')) {
        message.error('You can only upload PDF files!');
        return false;
      }
      return true; // Return true to allow upload
    },
    onChange: ({ fileList: newFileList }) => {
      // Filter to only include PDF files
      const pdfFiles = newFileList.filter(file =>
        file.status !== 'removed' && (
          file.type === 'application/pdf' ||
          (file.name && file.name.endsWith('.pdf'))
        )
      );
      setFileList(pdfFiles);
    },
    onDrop: (e) => {
      console.log('Dropped files', e.dataTransfer.files);
    },
  };

  const handleUpload = async () => {
    await handleUploadCodes(fileList, setUploadModalVisible, setFileList, setLoading, setCounts, userEmail);
  };

  const handleLogin = async () => {
    const success = await generateOTP(otpEmail, setOtpLoading);
    if (success) {
      // OTP was generated successfully, show verification modal
      setShowOtpModal(true);
    }
  };

  const handleVerify = async () => {
    const success = await verifyOTP(otpEmail, otpCode, setOtpLoading, setIsAuthenticated, setUserEmail);
    if (success) {
      // Close the OTP modal and refresh activities after successful authentication
      setShowOtpModal(false);
      fetchWarehouseActivities(setActivities);
    }
  };

  const handleLogout = () => {
    setIsAuthenticated(false);
    setUserEmail('');
    setOtpEmail('');
    setOtpCode('');
    localStorage.removeItem('warehouseUserEmail');
  };

  // Main warehouse view - accessible to everyone
  return (
    <div>
      <Card size="small">
        <div style={{ textAlign: 'center', padding: '10px 0 0' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10 }}>
            <div>
              {isAuthenticated ? (
                <>
                  <Text type="secondary">Authenticated as: </Text>
                  <Text strong>{userEmail}</Text>
                </>
              ) : (
                <>
                  <Text type="secondary">Not authenticated. </Text>
                  <Button type="link" onClick={() => setShowOtpModal(true)} size="small">Authenticate</Button>
                </>
              )}
            </div>
            <div>
              {isAuthenticated && (
                <Button onClick={handleLogout} size="small" style={{ marginRight: 8 }}>
                  Logout
                </Button>
              )}
              <Button
                icon={<ReloadOutlined />}
                size="small"
                onClick={() => {
                  fetchWarehouseCounts(setCounts);
                  fetchWarehouseActivities(setActivities);
                }}
              />
            </div>
          </div>
        </div>

        <div style={{ textAlign: 'center', padding: '0 0 15px' }}>

          <div style={{ marginBottom: '10px' }}>
            <h3 style={{ marginTop: 0, marginBottom: '8px', textAlign: 'center', fontSize: '16px' }}>Select License Type</h3>
            <div style={{
              display: 'flex',
              justifyContent: 'center',
              gap: '8px',
              flexWrap: 'wrap'
            }}>
              <div
                onClick={() => setSelectedType('All')}
                style={{
                  backgroundColor: selectedType === 'All' ? '#1890ff' : '#f0f5ff',
                  padding: '10px 15px',
                  borderRadius: '4px',
                  minWidth: '80px',
                  boxShadow: '0 1px 2px rgba(0, 0, 0, 0.1)',
                  border: selectedType === 'All' ? '1px solid #1890ff' : '1px solid #d9e7ff',
                  textAlign: 'center',
                  cursor: 'pointer',
                  transition: 'all 0.2s',
                  transform: selectedType === 'All' ? 'scale(1.03)' : 'scale(1)'
                }}
              >
                <div style={{ fontSize: '12px', color: selectedType === 'All' ? '#fff' : '#666' }}>Total</div>
                <div style={{ fontSize: '16px', fontWeight: 'bold', color: selectedType === 'All' ? '#fff' : '#1890ff' }}>{counts.total}</div>
              </div>
              <div
                onClick={() => setSelectedType('FortiGate')}
                style={{
                  backgroundColor: selectedType === 'FortiGate' ? '#52c41a' : '#fff',
                  padding: '10px 15px',
                  borderRadius: '4px',
                  minWidth: '80px',
                  boxShadow: '0 1px 2px rgba(0, 0, 0, 0.1)',
                  border: selectedType === 'FortiGate' ? '1px solid #52c41a' : '1px solid #e8e8e8',
                  textAlign: 'center',
                  cursor: 'pointer',
                  transition: 'all 0.2s',
                  transform: selectedType === 'FortiGate' ? 'scale(1.03)' : 'scale(1)'
                }}
              >
                <div style={{ fontSize: '12px', color: selectedType === 'FortiGate' ? '#fff' : '#666' }}>FortiGate</div>
                <div style={{ fontSize: '16px', fontWeight: 'bold', color: selectedType === 'FortiGate' ? '#fff' : '#52c41a' }}>{counts.fortigate}</div>
              </div>
              <div
                onClick={() => setSelectedType('FortiAuthenticator')}
                style={{
                  backgroundColor: selectedType === 'FortiAuthenticator' ? '#fa8c16' : '#fff',
                  padding: '10px 15px',
                  borderRadius: '4px',
                  minWidth: '80px',
                  boxShadow: '0 1px 2px rgba(0, 0, 0, 0.1)',
                  border: selectedType === 'FortiAuthenticator' ? '1px solid #fa8c16' : '1px solid #e8e8e8',
                  textAlign: 'center',
                  cursor: 'pointer',
                  transition: 'all 0.2s',
                  transform: selectedType === 'FortiAuthenticator' ? 'scale(1.03)' : 'scale(1)'
                }}
              >
                <div style={{ fontSize: '12px', color: selectedType === 'FortiAuthenticator' ? '#fff' : '#666' }}>FortiAuth</div>
                <div style={{ fontSize: '16px', fontWeight: 'bold', color: selectedType === 'FortiAuthenticator' ? '#fff' : '#fa8c16' }}>{counts.fortiauthenticator}</div>
              </div>
              <div
                onClick={() => setSelectedType('FortiToken')}
                style={{
                  backgroundColor: selectedType === 'FortiToken' ? '#722ed1' : '#fff',
                  padding: '10px 15px',
                  borderRadius: '4px',
                  minWidth: '80px',
                  boxShadow: '0 1px 2px rgba(0, 0, 0, 0.1)',
                  border: selectedType === 'FortiToken' ? '1px solid #722ed1' : '1px solid #e8e8e8',
                  textAlign: 'center',
                  cursor: 'pointer',
                  transition: 'all 0.2s',
                  transform: selectedType === 'FortiToken' ? 'scale(1.03)' : 'scale(1)'
                }}
              >
                <div style={{ fontSize: '12px', color: selectedType === 'FortiToken' ? '#fff' : '#666' }}>FortiToken</div>
                <div style={{ fontSize: '16px', fontWeight: 'bold', color: selectedType === 'FortiToken' ? '#fff' : '#722ed1' }}>{counts.fortitoken}</div>
              </div>
              <div
                onClick={() => setSelectedType('FortiIdentityCloud')}
                style={{
                  backgroundColor: selectedType === 'FortiIdentityCloud' ? '#13c2c2' : '#fff',
                  padding: '10px 15px',
                  borderRadius: '4px',
                  minWidth: '80px',
                  boxShadow: '0 1px 2px rgba(0, 0, 0, 0.1)',
                  border: selectedType === 'FortiIdentityCloud' ? '1px solid #13c2c2' : '1px solid #e8e8e8',
                  textAlign: 'center',
                  cursor: 'pointer',
                  transition: 'all 0.2s',
                  transform: selectedType === 'FortiIdentityCloud' ? 'scale(1.03)' : 'scale(1)'
                }}
              >
                <div style={{ fontSize: '12px', color: selectedType === 'FortiIdentityCloud' ? '#fff' : '#666' }}>FIC</div>
                <div style={{ fontSize: '16px', fontWeight: 'bold', color: selectedType === 'FortiIdentityCloud' ? '#fff' : '#13c2c2' }}>{counts.fortidentitycloud}</div>
              </div>
            </div>
          </div>

          <Space size="middle" style={{ margin: '15px 0' }}>
            <Button
              type="primary"
              icon={<CopyOutlined />}
              size="middle"
              onClick={() => handleCopyRandomCode(selectedType, setLoading, setCounts, userEmail)}
              loading={loading}
              disabled={
                !isAuthenticated ||
                selectedType === 'All' ? true :
                selectedType === 'FortiGate' ? counts.fortigate === 0 :
                selectedType === 'FortiAuthenticator' ? counts.fortiauthenticator === 0 :
                selectedType === 'FortiToken' ? counts.fortitoken === 0 :
                selectedType === 'FortiIdentityCloud' ? counts.fortidentitycloud === 0 :
                counts.total === 0
              }
              style={{ minWidth: '150px' }}
            >
              Copy Random Code
            </Button>

            <Button
              type="default"
              icon={<UploadOutlined />}
              size="middle"
              onClick={() => setUploadModalVisible(true)}
              disabled={!isAuthenticated}
              style={{ minWidth: '150px' }}
            >
              Upload PDFs
            </Button>

            <Button
              icon={<ReloadOutlined />}
              onClick={() => {
                fetchWarehouseCounts(setCounts);
                fetchWarehouseActivities(setActivities);
              }}
            >
              Refresh
            </Button>
          </Space>

          {/* Recycle Section */}
          <div style={{ marginTop: 20, paddingTop: 15, borderTop: '1px solid #eee' }}>
            <h3 style={{ fontSize: '16px', marginBottom: '8px' }}>Recycle Code</h3>
            <p style={{ color: '#666', fontSize: '12px', margin: '5px 0' }}>If a copied code was not used, you can recycle it back into the pool.</p>
            <Space direction="vertical" size="small" style={{ width: '100%', maxWidth: '300px', margin: '0 auto' }}>
              <Input
                placeholder="Enter code to recycle"
                value={recycleCode}
                onChange={(e) => setRecycleCode(e.target.value)}
                style={{ width: '100%' }}
                size="small"
              />
              <Button
                type="dashed"
                onClick={() => handleRecycleCode(recycleCode, setRecycleCode, setLoading, setCounts, userEmail)}
                disabled={!isAuthenticated || !recycleCode.trim()}
                loading={loading}
                style={{ width: '100%' }}
                size="small"
              >
                Recycle Code
              </Button>
            </Space>
          </div>
        </div>
      </Card>

      {/* User Activities Section */}
      <Card size="small" style={{ marginTop: 15, maxHeight: '300px', overflow: 'hidden' }}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '10px' }}>
          <Title level={5} style={{ margin: 0 }}>Recent Activities</Title>
          <Button
            icon={<ReloadOutlined />}
            size="small"
            onClick={() => fetchWarehouseActivities(setActivities)}
          />
        </div>
        <div style={{ maxHeight: '250px', overflowY: 'auto' }}>
          <List
            dataSource={activities.slice(0, 20)} // Show last 20 activities
            renderItem={(activity) => (
              <List.Item style={{ padding: '8px 0' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', width: '100%', fontSize: '12px' }}>
                  <div>
                    <Text strong>{activity.user_name}</Text>
                    <Text type="secondary"> {activity.action}</Text>
                    {activity.code_type && (
                      <Text type="secondary"> • {activity.code_type}</Text>
                    )}
                  </div>
                  <Text type="secondary">{new Date(activity.created_at).toLocaleTimeString()}</Text>
                </div>
                {(activity.code_value || activity.count) && (
                  <div style={{ display: 'flex', width: '100%', fontSize: '11px', marginTop: '2px' }}>
                    {activity.code_value && (
                      <Text code style={{ marginRight: '10px' }}>{activity.code_value}</Text>
                    )}
                    {activity.count && (
                      <Text type="secondary">{activity.count} files</Text>
                    )}
                  </div>
                )}
              </List.Item>
            )}
          />
        </div>
      </Card>

      <Modal
        title="Upload PDF Files"
        open={uploadModalVisible}
        onOk={handleUpload}
        onCancel={() => {
          setUploadModalVisible(false);
          setFileList([]);
        }}
        okText="Upload"
        confirmLoading={loading}
        width={400}
      >
        <Upload.Dragger {...uploadProps}>
          <p className="ant-upload-drag-icon">
            <UploadOutlined />
          </p>
          <p className="ant-upload-text">Click or drag PDF files to this area to upload</p>
          <p className="ant-upload-hint">
            Only PDF files containing FortiGate, FortiAuthenticator, FortiIdentity Cloud, or FortiToken codes are supported
          </p>
        </Upload.Dragger>
      </Modal>

      {/* OTP Verification Modal */}
      <Modal
        title="Warehouse Authentication"
        open={showOtpModal}
        onOk={handleVerify}
        onCancel={() => {
          setShowOtpModal(false);
          setOtpCode('');
        }}
        okText="Verify"
        confirmLoading={otpLoading}
        closable={true}
        width={400}
      >
        <Form form={authForm} layout="vertical">
          <Form.Item
            label="Email Address"
            name="email"
            rules={[{ required: true, message: 'Please enter your email' }]}
          >
            <Input
              prefix={<UserOutlined />}
              placeholder="user@fortinet.com"
              value={otpEmail}
              onChange={(e) => setOtpEmail(e.target.value)}
              disabled={otpLoading}
            />
          </Form.Item>

          <Form.Item
            label="Enter OTP sent to your email"
            name="otp"
          >
            <Input
              prefix={<LockOutlined />}
              placeholder="Enter 6-digit OTP"
              value={otpCode}
              onChange={(e) => setOtpCode(e.target.value)}
              disabled={otpLoading}
            />
          </Form.Item>

          <Button
            type="primary"
            onClick={handleLogin}
            loading={otpLoading}
            disabled={!otpEmail || !otpEmail.includes('@fortinet.com')}
            block
            style={{ marginBottom: 16 }}
          >
            Generate OTP
          </Button>

          <Text type="secondary">
            Please check your email for the OTP code. If you haven't received it, click "Generate OTP" again.
          </Text>
        </Form>
      </Modal>
    </div>
  );
};

export default UnifiedWarehouse;